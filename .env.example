# =============================================================================
# Playwright Manager - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Only DATABASE_URL is required. Everything else is optional.

# --- Required ---

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/playwright_test_manager

# --- Dashboard ---

# Public URL of the dashboard (used for generating links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- S3 Report Storage (optional) ---
# Configure these to enable Playwright HTML report hosting.
# Compatible with AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces, etc.

# S3_BUCKET=playwright-reports
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000          # For MinIO/R2/non-AWS providers
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- MinIO (local S3-compatible storage, used with docker-compose) ---

# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
