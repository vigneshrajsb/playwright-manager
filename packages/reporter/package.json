{
  "name": "@playwright-manager/reporter",
  "version": "0.7.0",
  "description": "Playwright reporter for Test Manager Dashboard",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playwright-manager": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.25.0"
  },
  "dependencies": {
    "jiti": "^2.0.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.500.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "playwright",
    "reporter",
    "test-manager"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vigneshrajsb/playwright-manager.git",
    "directory": "packages/reporter"
  }
}
