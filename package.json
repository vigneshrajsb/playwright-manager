{
  "name": "playwright-manager",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @playwright-manager/dashboard dev",
    "dev:docs": "pnpm --filter @playwright-manager/docs dev",
    "build": "pnpm --filter @playwright-manager/dashboard build",
    "build:docs": "pnpm --filter @playwright-manager/docs build",
    "start": "pnpm --filter @playwright-manager/dashboard start",
    "lint": "pnpm --filter @playwright-manager/dashboard lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "db:generate": "pnpm --filter @playwright-manager/dashboard db:generate",
    "db:migrate": "pnpm --filter @playwright-manager/dashboard db:migrate",
    "db:push": "pnpm --filter @playwright-manager/dashboard db:push",
    "db:seed": "pnpm --filter @playwright-manager/dashboard db:seed",
    "db:studio": "pnpm --filter @playwright-manager/dashboard db:studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
